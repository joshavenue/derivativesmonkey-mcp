{
  "name": "derivativesmonkey-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing the crypto options analytics on derivativesmonkey.com (IV, skew, GEX, flow, blocks, futures, quant models) as read-only tools for AI agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshavenue/derivativesmonkey-mcp.git"
  },
  "private": true,
  "bin": {
    "derivativesmonkey-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "guide": "node scripts/gen-guide.mjs",
    "build": "node scripts/gen-guide.mjs --check && tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js',0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "smoke": "tsx scripts/smoke.ts",
    "login": "tsx scripts/login.ts",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.23.15",
    "typescript": "^5.9"
  },
  "optionalDependencies": {
    "playwright-core": "^1.64.0"
  }
}
